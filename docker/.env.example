# SQL Server Configuration
SQL_SA_PASSWORD=YourStrong!Passw0rd

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Authentication Configuration
AUTH_PROTOCOL=InHouse
AUTH_ISSUER=http://localhost:5001
AUTH_AUDIENCE=myapp-api
AUTH_TOKEN_LIFETIME=01:00:00
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=00:15:00
AUTH_SIGNING_KEY_PATH=/app/dev-signing-key.pem

# SAML Configuration (if using SAML protocol)
# SAML_METADATA_URL=https://idp.example.com/metadata
# SAML_SERVICE_PROVIDER_ENTITY_ID=https://auth.myapp.com/saml

# OAuth Configuration (if using OAuth protocol)
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_AUTHORIZATION_ENDPOINT=https://oauth.example.com/authorize
# OAUTH_TOKEN_ENDPOINT=https://oauth.example.com/token

# OIDC Configuration (if using OIDC protocol)
# OIDC_AUTHORITY=https://login.microsoftonline.com/tenant-id
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret

# LDAP Configuration (if using LDAP protocol)
# LDAP_SERVER_URL=ldaps://corp.example.com:636
# LDAP_BASE_DN=dc=corp,dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=corp,dc=example,dc=com
# LDAP_BIND_PASSWORD=admin-password
