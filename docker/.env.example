# Environment Configuration for SdxCore Authentication Module
# Copy this file to .env and update the values for your environment

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# SQL Server Configuration
SQL_SA_PASSWORD=office.1234!

# Authentication Configuration
AUTH_PROTOCOL=InHouse
AUTH_ISSUER=http://localhost:5001
AUTH_AUDIENCE=myapp-api
AUTH_TOKEN_LIFETIME=01:00:00
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=00:15:00
AUTH_SIGNING_KEY_PATH=/app/dev-signing-key.pem

# SAML Configuration (if using SAML protocol)
# SAML_IDP_METADATA_URL=https://your-idp.com/metadata
# SAML_SERVICE_PROVIDER_ENTITY_ID=your-sp-entity-id
# SAML_CERTIFICATE_PATH=/app/saml-cert.pem

# OAuth Configuration (if using OAuth protocol)
# OAUTH_CLIENT_ID=your-oauth-client-id
# OAUTH_CLIENT_SECRET=your-oauth-client-secret
# OAUTH_AUTHORITY_URL=https://your-oauth-provider.com

# OIDC Configuration (if using OIDC protocol)
# OIDC_AUTHORITY=https://your-oidc-provider.com
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret

# LDAP Configuration (if using LDAP protocol)
# LDAP_SERVER=ldaps://your-ldap-server.com:636
# LDAP_BASE_DN=dc=company,dc=com
# LDAP_BIND_DN=cn=service-account,ou=users,dc=company,dc=com
# LDAP_BIND_PASSWORD=service-account-password

# JWT Configuration (if using JWT protocol)
# JWT_ISSUER=https://your-jwt-issuer.com
# JWT_AUDIENCE=your-jwt-audience
# JWT_SIGNING_KEY=your-jwt-signing-key

# ── Redis ──────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Elasticsearch ──────────────────────────────────────────
ES_PORT=9200
ES_KIBANA_PORT=5601
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=sdxcore
RABBITMQ_DEFAULT_PASS=sdxcore_secret

# ── File Storage ───────────────────────────────────────────
FILE_STORAGE_PROVIDER=SharedFileSystem
FILE_STORAGE_ROOT=/mnt/sdxcore-files
FILE_STORAGE_ENV=development
FILE_STORAGE_TENANT=sdxcore
