{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "SdxCore.Gateway.API.Middleware": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "IdentityServiceUrl": "https://localhost:7001",
    "InternalApiKey": "Gateway-Internal-Key-2024-SecureToken-DoNotExpose",
    "PublicRoutes": [
      "/health",
      "/api/auth/token",
      "/api/auth/create-user",
      "/api/auth/refresh-token",
      "/api/auth/revoke-token",
      "/api/public/*",
      "/api/catalog/products",
      "/swagger/*",
      "/api/docs/*"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{action:regex(^token$|^create-user$|^refresh-token$|^revoke-token$)}"
        },
        "Metadata": {
          "RequiresAuthentication": "false"
        }
      },
      "identity-protected-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{action}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-For",
            "Append": "{RemoteIpAddress}"
          }
        ],
        "Metadata": {
          "RequiresAuthentication": "true",
          "Note": "validate-token is NOT exposed through this route - internal only"
        }
      },
      "shared-route": {
        "ClusterId": "shared-cluster",
        "Match": {
          "Path": "/api/lookups/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https://localhost:7001"
          }
        }
      },
      "shared-cluster": {
        "Destinations": {
          "shared-api": {
            "Address": "https://localhost:7002"
          }
        }
      }
    }
  }
}