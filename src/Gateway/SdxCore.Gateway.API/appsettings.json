{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "SdxCore.Gateway.API.Middleware": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "IdentityServiceUrl": "https://localhost:5001",
    "InternalApiKey": "Gateway-Internal-Key-2024-SecureToken-DoNotExpose",
    "PublicRoutes": [
      "/health",
      "/api/auth/login",
      "/api/public/*",
      "/api/catalog/products",
      "/swagger/*",
      "/api/docs/*"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/login"
        },
        "Metadata": {
          "RequiresAuthentication": "false"
        }
      },
      "identity-protected-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{action}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-For",
            "Append": "{RemoteIpAddress}"
          }
        ],
        "Metadata": {
          "RequiresAuthentication": "true",
          "Note": "validate-token is NOT exposed through this route - internal only"
        }
      },
      "catalog-public-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/products"
        },
        "Metadata": {
          "RequiresAuthentication": "false"
        }
      },
      "catalog-protected-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "public-api-route": {
        "ClusterId": "public-cluster",
        "Match": {
          "Path": "/api/public/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "false"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "catalog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "catalog-api-1": {
            "Address": "https://localhost:5002"
          },
          "catalog-api-2": {
            "Address": "https://localhost:5003"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-api": {
            "Address": "https://localhost:5004"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "users-api": {
            "Address": "https://localhost:5005"
          }
        }
      },
      "public-cluster": {
        "Destinations": {
          "public-api": {
            "Address": "https://localhost:5006"
          }
        }
      }
    }
  }
}
