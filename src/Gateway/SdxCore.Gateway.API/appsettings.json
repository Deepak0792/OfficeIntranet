{
  "ServiceName": "gateway",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "SdxCore.Gateway.API.Middleware": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "IdentityServiceUrl": "https://localhost:7001",
    "InternalApiKey": "Gateway-Internal-Key-2024-SecureToken-DoNotExpose",
    "PublicRoutes": [
      "/health",
      "/api/v1/auth/token",
      "/swagger/*",
      "/api/docs/*"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{action:regex(^token$)}"
        },
        "Metadata": {
          "RequiresAuthentication": "false"
        }
      },
      "identity-protected-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{action}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-For",
            "Append": "{RemoteIpAddress}"
          }
        ],
        "Metadata": {
          "RequiresAuthentication": "true",
          "Note": "validate-token is NOT exposed through this route - internal only"
        }
      },
      "shared-route": {
        "ClusterId": "shared-cluster",
        "Match": {
          "Path": "/api/v1/lookups/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "biometric-devices-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/biometric-devices/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "countries-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/countries/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "departments-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/departments/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "designations-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/designations/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "document-types-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/document-types/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "geo-fences-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/geo-fences/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "legal-entities-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/legal-entities/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "office-locations-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/office-locations/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "regions-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/regions/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "scope-types-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/scope-types/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "time-zones-route": {
        "ClusterId": "time-cluster",
        "Match": {
          "Path": "/api/v1/time-zones/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "employee-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/v1/employees/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "team-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/v1/teams/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "skill-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/v1/skills/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      },
      "biometric-mappings-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/v1/biometric-mappings/{**catch-all}"
        },
        "Metadata": {
          "RequiresAuthentication": "true"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https://localhost:7001"
          }
        }
      },
      "shared-cluster": {
        "Destinations": {
          "shared-api": {
            "Address": "https://localhost:7002"
          }
        }
      },
      "time-cluster": {
        "Destinations": {
          "time-api": {
            "Address": "https://localhost:7003"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-api": {
            "Address": "https://localhost:7004"
          }
        }
      },
      "employee-cluster": {
        "Destinations": {
          "employee-api": {
            "Address": "https://localhost:7005"
          }
        }
      }
    }
  },
  "OutboxSettings": {
    "PublishableEntities": [],
    "BatchSize": 50,
    "MaxRetries": 3,
    "PollingIntervalSeconds": 5
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=redis.1234",
    "InstanceName": "sdxcore:gateway:"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "sdxcore",
    "Username": "sdxcore",
    "Password": "sdxcore_secret"
  }
}