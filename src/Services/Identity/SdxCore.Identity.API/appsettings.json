{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SdxCoreIdentity;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Authentication": {
    "Protocol": "InHouse",
    "Issuer": "https://sdxcore.identity.api",
    "Audience": "https://sdxcore.api",
    "TokenLifetime": "01:00:00",
    "MaxFailedAttempts": 5,
    "LockoutDuration": "00:15:00",
    "SigningKeyPath": "keys/signing-key.json",
    "SigningAlgorithm": "HS256",
    "SecretKey": "your-secret-key-min-32-chars-long-change-in-production",
    "InternalApiKey": "Gateway-Internal-Key-2024-SecureToken-DoNotExpose"
  },
  "Saml": {
    "EntityId": "https://sdxcore.identity.api/saml",
    "IdpMetadataUrl": "https://idp.example.com/metadata",
    "IdpSingleSignOnUrl": "https://idp.example.com/sso",
    "IdpCertificatePath": "certificates/idp-cert.pem",
    "AssertionConsumerServiceUrl": "https://sdxcore.identity.api/saml/acs",
    "RequireSignedAssertion": true,
    "ClockSkewMinutes": 5
  },
  "OAuth": {
    "ClientId": "your-oauth-client-id",
    "ClientSecret": "your-oauth-client-secret",
    "AuthorizationEndpoint": "https://oauth.example.com/authorize",
    "TokenEndpoint": "https://oauth.example.com/token",
    "RedirectUri": "https://sdxcore.identity.api/oauth/callback",
    "Scope": "openid profile email",
    "UsePkce": true
  },
  "Oidc": {
    "Authority": "https://oidc.example.com",
    "ClientId": "your-oidc-client-id",
    "ClientSecret": "your-oidc-client-secret",
    "RedirectUri": "https://sdxcore.identity.api/oidc/callback",
    "Scope": "openid profile email",
    "ResponseType": "code",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "RequireHttpsMetadata": true
  },
  "Ldap": {
    "Server": "ldaps://ldap.example.com:636",
    "BaseDn": "dc=example,dc=com",
    "BindDn": "cn=admin,dc=example,dc=com",
    "BindPassword": "your-ldap-bind-password",
    "SearchFilter": "(uid={0})",
    "UseLdaps": true,
    "ValidateServerCertificate": true,
    "ConnectionTimeout": 30,
    "UseConnectionPooling": true
  }
}
